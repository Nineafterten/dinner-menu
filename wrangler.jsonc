// Serves the Vite build in dist/ as static assets. Cloudflare builds it from
// GitHub; the app runs on-device, with the menu published as /menu.json.
{
  "name": "dinner-menu",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true
}
