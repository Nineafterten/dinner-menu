# Copy this file to `.env` and fill in your Supabase project values.
# Without these, the app runs against browser localStorage (single-device, no sync).
# With them, data syncs across laptop / phone / iPad in real time.
#
# Find these in your Supabase project: Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
